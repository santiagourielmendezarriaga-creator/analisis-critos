# Plantilla de Secrets. NO pongas aquí valores reales.
# En Streamlit Cloud: App → Settings → Secrets, y pega estas claves con tus valores.
# En local: copia este archivo como .streamlit/secrets.toml (está en .gitignore).

# --- Bitso ---
BITSO_API_KEY = ""
BITSO_API_SECRET = ""
MODO_REAL = false
MONTO_MAXIMO_POR_OPERACION = 50
MONTO_MAXIMO_DIARIO = 100

# --- Operación automática (DINERO REAL; requiere MODO_REAL = true y Firebase) ---
# Compra con las señales >= 70% que pasan el flujo de IAs y vende por TP 5% / SL 1% o señal contraria.
# Se pausa sola tras 2 pérdidas seguidas. Déjalo en false hasta estar seguro.
OPERAR_AUTOMATICO = false
MONTO_AUTOMATICO = 50

# --- Telegram ---
TELEGRAM_TOKEN = ""
TELEGRAM_CHAT_ID = ""
TELEGRAM_CANAL_ID = ""

# --- Gemini ---
GEMINI_API_KEY = ""
# Opcional: cambia el modelo sin tocar el código
# GEMINI_MODELO = "gemini-3.8-flash"

# --- Firebase (opcional: si no lo pones, se usan los valores del código) ---
# FIREBASE_URL = "https://TU-PROYECTO-default-rtdb.firebaseio.com"
# FIREBASE_RUTA = "una-ruta-privada-larga-y-aleatoria"

# --- Segunda opinión en las señales (opcional) ---
# Groq tiene plan gratuito. Se usa primero; si falla, se prueba DeepSeek.
# GROQ_API_KEY = ""
# GROQ_MODELO = "llama-3.3-70b-versatile"
# DEEPSEEK_API_KEY = ""
# DEEPSEEK_MODELO = "deepseek-flash"
